# Copy to .env.local and adjust.

# NestJS API base URL used by Next.js route handlers (server side, never exposed to the browser).
API_URL=http://localhost:3000/api/v1

# NestJS API base URL used by the browser. Usually the same as API_URL.
# Live backend: https://hissabsync.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Google Identity Services client ID (must equal GOOGLE_CLIENT_ID in the backend .env).
# Leave empty to hide the "Sign in with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
